# =============================================================================
# Restaurant OS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://restaurantuser:restaurantpassword@localhost:5432/restaurant_os?schema=public"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS_DIFFERENT
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# MinIO (S3-compatible object storage)
# ─────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_MENU_IMAGES=menu-images
MINIO_BUCKET_FILES=files
MINIO_PUBLIC_URL=http://localhost:9000

# ─────────────────────────────────────────────
# AI / OCR (all optional — falls back to rule-based)
# ─────────────────────────────────────────────
# AI provider: 'tesseract' | 'ollama' | 'none'
AI_PROVIDER=tesseract

# Ollama (optional local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava

# ─────────────────────────────────────────────
# Payment
# ─────────────────────────────────────────────
# Provider: 'manual' | 'razorpay' (razorpay not implemented in MVP)
PAYMENT_PROVIDER=manual

# ─────────────────────────────────────────────
# Notification
# ─────────────────────────────────────────────
# Provider: 'console' | 'smtp'
NOTIFICATION_PROVIDER=console

# SMTP (only needed if NOTIFICATION_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Restaurant OS <noreply@restaurant-os.local>"

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10

# ─────────────────────────────────────────────
# File Upload
# ─────────────────────────────────────────────
MAX_FILE_SIZE_BYTES=10485760
# 10 MB

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=info
# Options: fatal, error, warn, info, debug, trace

# ─────────────────────────────────────────────
# Currency / Tax
# ─────────────────────────────────────────────
DEFAULT_CURRENCY=INR
DEFAULT_TAX_RATE=5
# GST slab options: 0, 5, 12, 18, 28
